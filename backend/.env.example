# OpenRouter (recommended): one key for Qwen, DeepSeek, GPT-OSS, GLM, etc.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional metadata sent to OpenRouter
OPENROUTER_SITE_URL=https://codegen-ui-xi.vercel.app
OPENROUTER_APP_NAME=CodeGen UI

# Optional: only needed if you select a direct OpenAI model in the UI
OPENAI_API_KEY=your-openai-api-key-here

FLASK_ENV=development
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# Secure execution for CodeGen Lab
E2B_API_KEY=your-e2b-api-key-here
